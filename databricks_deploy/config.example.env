# databricks_deploy — environment variables per component.
# Copy/adapt into each Databricks endpoint's / App's env config. SECRETS go through a Databricks
# secret scope (e.g. {{secrets/feedsai/databricks_token}}) — NEVER paste raw tokens here or in code.

# ──────────────────────────────────────────────────────────────────────────────────────────
# 1) ROUTER serving endpoint  (parrot-api-hitashi-dev v3 — the pyfunc in serving/)
#    Reuses router/src/config.py, which reads all of these from the environment.
# ──────────────────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=databricks
DATABRICKS_LLM_ENDPOINT=https://dbc-f79d5cae-0d05.cloud.databricks.com/serving-endpoints/llama_v3_3_70b_instruct_Ishaan/invocations
DATABRICKS_TOKEN={{secrets/feedsai/databricks_token}}
GRAPH_API_URL=https://<graph-app>.aws.databricksapps.com       # the Graph App (Neo4j/AuraDS engine)
VECTOR_API_URL=https://<vector-app>.aws.databricksapps.com     # the Vector App (Vector Search engine)
LLM_TIMEOUT_S=120
ROUTER_HTTP_TIMEOUT_S=30

# ──────────────────────────────────────────────────────────────────────────────────────────
# 2) VECTOR App  (vector/pipeline served as a Databricks App; uses Vector Search for dense ANN)
# ──────────────────────────────────────────────────────────────────────────────────────────
VECTOR_BACKEND=databricks
VS_ENDPOINT_NAME=feedsai-vs
VS_INDEX_NAME=dev_feeds_silver.ml.entities_vs
# Qwen embeds the live query at request time (OpenAI-compatible llm/v1/embeddings). Reuses DATABRICKS_TOKEN.
DATABRICKS_EMBEDDING_ENDPOINT=https://dbc-f79d5cae-0d05.cloud.databricks.com/serving-endpoints/qwen3-embedding-0-6b/invocations
# EMBEDDING_QUERY_INSTRUCTION=                                 # optional Qwen query-instruction prefix (leave blank if endpoint applies it)
DATABRICKS_TOKEN={{secrets/feedsai/databricks_token}}         # vector NLU also calls the FM endpoint
DATABRICKS_LLM_ENDPOINT=https://dbc-f79d5cae-0d05.cloud.databricks.com/serving-endpoints/llama_v3_3_70b_instruct_Ishaan/invocations

# ──────────────────────────────────────────────────────────────────────────────────────────
# 3) GRAPH App  (src/ graph engine served as a Databricks App; talks to AuraDS)
# ──────────────────────────────────────────────────────────────────────────────────────────
NEO4J_URI=neo4j+s://<dbid>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD={{secrets/feedsai/neo4j_password}}
NEO4J_DATABASE=neo4j
NEO4J_AURA_DS=true                                             # GDS client connects in Aura mode (see load_aura.md)

# ──────────────────────────────────────────────────────────────────────────────────────────
# 4) build_index.py  (one-time, run inside Databricks)
# ──────────────────────────────────────────────────────────────────────────────────────────
UC_CATALOG=dev_feeds_silver
UC_SCHEMA=ml
SRC_VOLUME=/Volumes/dev_feeds_silver/ml/feedsai_src
